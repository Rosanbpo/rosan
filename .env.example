# Banco de dados PostgreSQL (não use credenciais reais em exemplos)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/central_bpo?schema=public"

# Banco usado apenas pelos testes de integração (será limpo a cada execução!)
TEST_DATABASE_URL="postgresql://usuario:senha@localhost:5432/central_bpo_test?schema=public"

# Auth.js — gere com: openssl rand -base64 32
AUTH_SECRET="troque-por-um-segredo-aleatorio"
# Em produção atrás de proxy/host próprio, informe a URL pública ou habilite trustHost
AUTH_TRUST_HOST="true"

# Segredo exigido pela rota /api/cron/gerar-tarefas (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET="troque-por-outro-segredo-aleatorio"

# Fuso padrão das rotinas
APP_TIMEZONE="America/Sao_Paulo"

# Nome exibido na interface (nome provisório)
NEXT_PUBLIC_APP_NAME="Central BPO"
