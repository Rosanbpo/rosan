generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Empresa de BPO, usuários e vínculos
// ---------------------------------------------------------------------------

model Organization {
  runningTimers RunningTimer[]
  pricingSheet  PricingSheet?
  contracts     Contract[]
  id            String         @id @default(cuid())
  name          String
  timezone      String         @default("America/Sao_Paulo")
  /// Custo médio da hora de trabalho (R$), usado na rentabilidade por cliente.
  hourCost      Decimal?       @db.Decimal(10, 2)
  /// Dados da empresa usados em propostas e contratos.
  legalName     String?
  cnpj          String?
  email         String?
  phone         String?
  website       String?
  city          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  memberships   Membership[]
  leads         Lead[]
  procedures    Procedure[]
  projects      Project[]
  timeEntries   TimeEntry[]
  proposals     Proposal[]
  clients       Client[]
  templates     RoutineTemplate[]
  recurrences   Recurrence[]
  tasks         Task[]
  holidays      Holiday[]
  auditEvents   AuditEvent[]
  pendings      Pending[]
  schedulerRuns SchedulerRun[]
}

model User {
  documentReceipts DocumentReceipt[] @relation("DocumentReceivedBy")
  runningTimer     RunningTimer?
  contractsCreated Contract[]
  id               String            @id @default(cuid())
  email            String            @unique
  name             String
  passwordHash     String
  active           Boolean           @default(true)
  /// Usuários criados pelo seed de demonstração. Bloqueados em produção.
  isDemo           Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  memberships        Membership[]
  clientMemberships  ClientMember[]
  responsibleClients Client[]        @relation("ClientResponsible")
  managedClients     Client[]        @relation("ClientManager")
  assignedTasks      Task[]          @relation("TaskAssignee")
  reviewTasks        Task[]          @relation("TaskReviewer")
  createdTasks       Task[]          @relation("TaskCreator")
  completedTasks     Task[]          @relation("TaskCompletedBy")
  reviewedTasks      Task[]          @relation("TaskReviewedBy")
  executedTasks      Task[]          @relation("TaskExecutedBy")
  comments           Comment[]
  evidences          Evidence[]
  checklistDone      ChecklistItem[]
  auditEvents        AuditEvent[]
  pendingsCreated    Pending[]       @relation("PendingCreatedBy")
  pendingsResolved   Pending[]       @relation("PendingResolvedBy")
  recurrenceAssignee Recurrence[]    @relation("RecurrenceAssignee")
  recurrenceReviewer Recurrence[]    @relation("RecurrenceReviewer")
  timeEntries        TimeEntry[]
  ownedLeads         Lead[]          @relation("LeadOwner")
  leadActivities     LeadActivity[]
  ownedProcedures    Procedure[]     @relation("ProcedureOwner")
  ownedProjects      Project[]       @relation("ProjectOwner")
  proposals          Proposal[]
}

enum Role {
  ADMIN
  GESTOR
  OPERADOR
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           Role
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, role])
}

// ---------------------------------------------------------------------------
// Clientes
// ---------------------------------------------------------------------------

enum ClientStatus {
  IMPLANTACAO
  ATIVO
  PAUSADO
  ENCERRADO
}

model Client {
  documentRequirements  DocumentRequirement[]
  contracts             Contract[]
  id                    String                @id @default(cuid())
  organizationId        String
  legalName             String
  tradeName             String
  cnpj                  String?
  contactName           String?
  contactEmail          String?
  contactPhone          String?
  contactChannels       String?
  status                ClientStatus          @default(IMPLANTACAO)
  services              String[]
  startDate             DateTime?             @db.Date
  notes                 String?
  /// Mensalidade contratada (R$) e dia de vencimento do boleto/fatura.
  monthlyFee            Decimal?              @db.Decimal(12, 2)
  billingDay            Int?
  responsibleOperatorId String?
  managerId             String?
  archivedAt            DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  responsibleOperator User?          @relation("ClientResponsible", fields: [responsibleOperatorId], references: [id])
  manager             User?          @relation("ClientManager", fields: [managerId], references: [id])
  members             ClientMember[]
  tasks               Task[]
  recurrences         Recurrence[]
  pendings            Pending[]
  timeEntries         TimeEntry[]
  projects            Project[]
  leadOrigin          Lead[]

  @@unique([organizationId, cnpj])
  @@index([organizationId, status])
  @@index([organizationId, tradeName])
}

/// Vínculo de usuário com cliente. Define quem pode acessar o cliente
/// (o operador responsável e o gestor também são registrados aqui).
model ClientMember {
  clientId  String
  userId    String
  createdAt DateTime @default(now())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([clientId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Modelos de rotina e recorrências
// ---------------------------------------------------------------------------

enum TaskCategory {
  CONTAS_A_PAGAR
  CONTAS_A_RECEBER
  CONCILIACAO_BANCARIA
  COBRANCA
  FLUXO_DE_CAIXA
  DOCUMENTACAO
  FECHAMENTO_MENSAL
  RELATORIOS_GERENCIAIS
  REUNIAO_CLIENTE
  IMPLANTACAO
  OUTRAS
}

enum Priority {
  BAIXA
  NORMAL
  ALTA
  CRITICA
}

enum Frequency {
  DAILY_BUSINESS
  WEEKLY
  BIWEEKLY
  MONTHLY_DAY
  MONTHLY_NTH_BUSINESS_DAY
}

enum NonBusinessDayRule {
  ANTICIPATE
  POSTPONE
}

enum CompetenceRule {
  NONE
  CURRENT_MONTH
  PREVIOUS_MONTH
}

model RoutineTemplate {
  id                 String             @id @default(cuid())
  organizationId     String
  name               String
  title              String
  description        String?
  category           TaskCategory
  priority           Priority           @default(NORMAL)
  estimatedMinutes   Int?
  requiresEvidence   Boolean            @default(false)
  competenceRule     CompetenceRule     @default(NONE)
  // Regras de prazo padrão (copiadas para a recorrência ao vincular a um cliente)
  frequency          Frequency          @default(MONTHLY_DAY)
  weekdays           Int[]
  monthDays          Int[]
  nthBusinessDay     Int?
  dueTime            String             @default("18:00")
  leadDays           Int                @default(3)
  startOffsetDays    Int                @default(0)
  nonBusinessDayRule NonBusinessDayRule @default(POSTPONE)
  /// POP que ensina a executar esta rotina (aparece nas tarefas geradas).
  procedureId        String?
  archivedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  procedure      Procedure?              @relation(fields: [procedureId], references: [id], onDelete: SetNull)
  checklistItems TemplateChecklistItem[]
  recurrences    Recurrence[]

  @@index([organizationId, archivedAt])
  @@index([procedureId])
}

model TemplateChecklistItem {
  id         String          @id @default(cuid())
  templateId String
  label      String
  required   Boolean         @default(false)
  position   Int             @default(0)
  template   RoutineTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, position])
}

enum RecurrenceStatus {
  ACTIVE
  PAUSED
}

model Recurrence {
  id                 String             @id @default(cuid())
  organizationId     String
  clientId           String
  templateId         String
  status             RecurrenceStatus   @default(ACTIVE)
  frequency          Frequency
  weekdays           Int[]
  monthDays          Int[]
  nthBusinessDay     Int?
  dueTime            String             @default("18:00")
  leadDays           Int                @default(3)
  startOffsetDays    Int                @default(0)
  nonBusinessDayRule NonBusinessDayRule @default(POSTPONE)
  timezone           String             @default("America/Sao_Paulo")
  startDate          DateTime           @db.Date
  endDate            DateTime?          @db.Date
  /// Data local a partir da qual ocorrências podem ser geradas. Atualizada ao
  /// criar e ao reativar, para não gerar retroativamente o período pausado.
  generationFloor    DateTime           @db.Date
  assigneeId         String?
  reviewerId         String?
  /// Projeto que recebe as tarefas geradas por esta rotina.
  projectId          String?
  lastGeneratedAt    DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  template     RoutineTemplate @relation(fields: [templateId], references: [id])
  assignee     User?           @relation("RecurrenceAssignee", fields: [assigneeId], references: [id])
  reviewer     User?           @relation("RecurrenceReviewer", fields: [reviewerId], references: [id])
  project      Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  tasks        Task[]

  @@index([organizationId, status])
  @@index([clientId])
}

model Holiday {
  id             String       @id @default(cuid())
  organizationId String
  date           DateTime     @db.Date
  name           String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, date])
}

// ---------------------------------------------------------------------------
// Tarefas
// ---------------------------------------------------------------------------

enum TaskStatus {
  A_FAZER
  EM_ANDAMENTO
  AGUARDANDO_CLIENTE
  AGUARDANDO_TERCEIRO
  EM_REVISAO
  CONCLUIDA
  CANCELADA
}

enum TaskOrigin {
  MANUAL
  RECORRENTE
}

model Task {
  runningTimers    RunningTimer[]
  id               String         @id @default(cuid())
  organizationId   String
  clientId         String
  title            String
  description      String?
  category         TaskCategory
  status           TaskStatus     @default(A_FAZER)
  priority         Priority       @default(NORMAL)
  competence       String? // AAAA-MM
  startAt          DateTime?
  dueAt            DateTime
  estimatedMinutes Int?
  requiresEvidence Boolean        @default(false)
  origin           TaskOrigin     @default(MANUAL)
  recurrenceId     String?
  projectId        String?
  /// Data nominal da ocorrência (antes de ajuste de dia útil). Chave de idempotência.
  occurrenceKey    String?
  assigneeId       String?
  reviewerId       String?
  createdById      String?
  executedById     String?
  executedAt       DateTime?
  reviewedById     String?
  reviewedAt       DateTime?
  completedById    String?
  completedAt      DateTime?
  returnCount      Int            @default(0)
  lastReturnReason String?
  archivedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  recurrence     Recurrence?     @relation(fields: [recurrenceId], references: [id], onDelete: SetNull)
  project        Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  timeEntries    TimeEntry[]
  assignee       User?           @relation("TaskAssignee", fields: [assigneeId], references: [id])
  reviewer       User?           @relation("TaskReviewer", fields: [reviewerId], references: [id])
  createdBy      User?           @relation("TaskCreator", fields: [createdById], references: [id])
  executedBy     User?           @relation("TaskExecutedBy", fields: [executedById], references: [id])
  reviewedBy     User?           @relation("TaskReviewedBy", fields: [reviewedById], references: [id])
  completedBy    User?           @relation("TaskCompletedBy", fields: [completedById], references: [id])
  checklistItems ChecklistItem[]
  comments       Comment[]
  evidences      Evidence[]
  pendings       Pending[]
  auditEvents    AuditEvent[]

  @@unique([recurrenceId, occurrenceKey])
  @@index([organizationId, status, dueAt])
  @@index([organizationId, assigneeId, status])
  @@index([organizationId, clientId, status])
  @@index([organizationId, reviewerId, status])
  @@index([organizationId, category])
  @@index([organizationId, completedAt])
  @@index([projectId])
}

model ChecklistItem {
  id       String    @id @default(cuid())
  taskId   String
  label    String
  required Boolean   @default(false)
  done     Boolean   @default(false)
  doneById String?
  doneAt   DateTime?
  position Int       @default(0)
  task     Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  doneBy   User?     @relation(fields: [doneById], references: [id])

  @@index([taskId, position])
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])

  @@index([taskId, createdAt])
}

model Evidence {
  id          String   @id @default(cuid())
  taskId      String
  url         String
  description String?
  addedById   String
  createdAt   DateTime @default(now())
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  addedBy     User     @relation(fields: [addedById], references: [id])

  @@index([taskId])
}

enum PendingType {
  CLIENTE
  TERCEIRO
}

model Pending {
  id             String       @id @default(cuid())
  organizationId String
  clientId       String
  taskId         String
  type           PendingType
  /// Informação ou documento necessário / motivo da pendência
  reason         String
  /// Quem precisa responder (pessoa ou área)
  respondent     String?
  requestedAt    DateTime     @default(now())
  followUpAt     DateTime     @db.Date
  resolvedAt     DateTime?
  resolution     String?
  createdById    String
  resolvedById   String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  task           Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdBy      User         @relation("PendingCreatedBy", fields: [createdById], references: [id])
  resolvedBy     User?        @relation("PendingResolvedBy", fields: [resolvedById], references: [id])

  @@index([organizationId, resolvedAt, followUpAt])
  @@index([taskId])
}

// ---------------------------------------------------------------------------
// Auditoria e agendador
// ---------------------------------------------------------------------------

model AuditEvent {
  id             String       @id @default(cuid())
  organizationId String
  actorId        String?
  entityType     String
  entityId       String
  taskId         String?
  clientId       String?
  action         String
  summary        String
  changes        Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User?        @relation(fields: [actorId], references: [id])
  task           Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([taskId, createdAt])
  @@index([clientId, createdAt])
  @@index([entityType, entityId])
}

model SchedulerRun {
  id             String        @id @default(cuid())
  organizationId String?
  startedAt      DateTime      @default(now())
  finishedAt     DateTime?
  created        Int           @default(0)
  skipped        Int           @default(0)
  errors         Int           @default(0)
  details        Json?
  trigger        String
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([startedAt])
}

/// Trava simples com expiração para impedir execuções simultâneas do agendador.
model SchedulerLock {
  id          String    @id
  lockedUntil DateTime?
  holder      String?
}

// ---------------------------------------------------------------------------
// Apontamento de horas
// ---------------------------------------------------------------------------

model TimeEntry {
  id             String   @id @default(cuid())
  organizationId String
  clientId       String
  taskId         String?
  userId         String
  /// Dia trabalhado (data de calendário).
  workedOn       DateTime @db.Date
  minutes        Int
  /// Duração exata quando veio do cronômetro.
  seconds        Int?
  note           String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  task         Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  user         User         @relation(fields: [userId], references: [id])

  @@index([organizationId, workedOn])
  @@index([clientId, workedOn])
  @@index([taskId])
  @@index([userId, workedOn])
}

// ---------------------------------------------------------------------------
// CRM comercial
// ---------------------------------------------------------------------------

enum LeadStage {
  NOVO
  CONTATO
  REUNIAO
  PROPOSTA
  NEGOCIACAO
  GANHO
  PERDIDO
}

model Lead {
  id                String    @id @default(cuid())
  organizationId    String
  companyName       String
  contactName       String?
  contactEmail      String?
  contactPhone      String?
  cnpj              String?
  source            String?
  stage             LeadStage @default(NOVO)
  expectedFee       Decimal?  @db.Decimal(12, 2)
  servicesInterest  String[]
  ownerId           String?
  nextActionAt      DateTime? @db.Date
  nextAction        String?
  lostReason        String?
  notes             String?
  convertedClientId String?
  closedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner           User?          @relation("LeadOwner", fields: [ownerId], references: [id])
  convertedClient Client?        @relation(fields: [convertedClientId], references: [id], onDelete: SetNull)
  activities      LeadActivity[]
  proposals       Proposal[]

  @@index([organizationId, stage])
  @@index([organizationId, nextActionAt])
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  authorId  String
  kind      String // NOTA, LIGACAO, REUNIAO, EMAIL, WHATSAPP, ETAPA
  body      String
  createdAt DateTime @default(now())

  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([leadId, createdAt])
}

// ---------------------------------------------------------------------------
// Processos e POPs
// ---------------------------------------------------------------------------

enum ProcedureStatus {
  RASCUNHO
  PUBLICADO
  ARQUIVADO
}

model Procedure {
  id             String          @id @default(cuid())
  organizationId String
  title          String
  category       TaskCategory
  status         ProcedureStatus @default(RASCUNHO)
  objective      String?
  /// Passo a passo em texto simples (uma linha por passo ou parágrafos).
  content        String
  tools          String?
  responsible    String?
  version        Int             @default(1)
  ownerId        String?
  reviewedAt     DateTime?       @db.Date
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?             @relation("ProcedureOwner", fields: [ownerId], references: [id])
  templates    RoutineTemplate[]

  @@index([organizationId, status])
  @@index([organizationId, category])
}

// ---------------------------------------------------------------------------
// Projetos
// ---------------------------------------------------------------------------

enum ProjectStatus {
  PLANEJADO
  EM_ANDAMENTO
  PAUSADO
  CONCLUIDO
  CANCELADO
}

model Project {
  id             String        @id @default(cuid())
  organizationId String
  clientId       String?
  name           String
  description    String?
  status         ProjectStatus @default(PLANEJADO)
  startDate      DateTime?     @db.Date
  dueDate        DateTime?     @db.Date
  ownerId        String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  owner        User?        @relation("ProjectOwner", fields: [ownerId], references: [id])
  tasks        Task[]
  recurrences  Recurrence[]

  @@index([organizationId, status])
  @@index([clientId])
}

// ---------------------------------------------------------------------------
// Propostas comerciais
// ---------------------------------------------------------------------------

enum ProposalStatus {
  RASCUNHO
  ENVIADA
  ACEITA
  RECUSADA
}

model Proposal {
  contracts      Contract[]
  id             String         @id @default(cuid())
  organizationId String
  /// Número sequencial por ano: 2026-001
  number         String
  leadId         String?
  planName       String
  companyName    String
  contactName    String?
  contactEmail   String?
  /// Mensagem de abertura personalizada.
  intro          String?
  /// Cada item no formato "Serviço | Descrição".
  services       String[]
  /// Cada item no formato "Descrição | Limite mensal".
  volumes        String[]
  /// O que não faz parte do escopo (uma linha por item).
  exclusions     String[]
  monthlyFee     Decimal        @db.Decimal(12, 2)
  billingDay     Int            @default(10)
  termMonths     Int            @default(12)
  validUntil     DateTime       @db.Date
  notes          String?
  status         ProposalStatus @default(RASCUNHO)
  sentAt         DateTime?
  createdById    String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  createdBy    User         @relation(fields: [createdById], references: [id])

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([leadId])
}

/// Planilha de precificação da empresa (uma por organização), editável.
model PricingSheet {
  id             String   @id @default(cuid())
  organizationId String   @unique
  /// [{ "label": "Aluguel", "amount": 500 }]
  costs          Json
  hoursPerDay    Decimal  @db.Decimal(5, 2)
  daysPerMonth   Int
  /// Margem de segurança sobre o custo/hora (1,10 = +10%).
  safetyFactor   Decimal  @db.Decimal(5, 2)
  /// Multiplicador de lucro (1,60 = 60%).
  markup         Decimal  @db.Decimal(5, 2)
  /// Imposto sobre o faturamento, em fração (0,06 = 6%).
  taxRate        Decimal  @db.Decimal(6, 4)
  /// [{ "name": "Plano Básico", "tasks": [{ "name": "...", "minutes": 30 }], "finalPrice": 500 }]
  plans          Json
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

enum ContractStatus {
  RASCUNHO
  ASSINADO
  ENCERRADO
}

/// Contrato de prestação de serviços (e o distrato correspondente).
model Contract {
  id             String         @id @default(cuid())
  organizationId String
  /// Número sequencial por ano: 2026-001
  number         String
  proposalId     String?
  clientId       String?
  status         ContractStatus @default(RASCUNHO)

  partyName     String
  partyDocument String?
  partyAddress  String?
  repName       String?
  repCpf        String?

  issuerRepName String?
  issuerRepRole String?
  issuerRepCpf  String?

  monthlyFee Decimal   @db.Decimal(12, 2)
  billingDay Int       @default(10)
  termMonths Int       @default(6)
  startDate  DateTime? @db.Date
  signDate   DateTime? @db.Date
  signCity   String?

  /// "Serviço | Descrição" e "Descrição | Limite".
  services String[]
  volumes  String[]
  /// [{ "section": "II — DO OBJETO", "title": "Do Objeto", "text": "...", "block": "services" }]
  clauses  Json

  // Distrato
  endDate         DateTime? @db.Date
  pendingMonthly  Decimal?  @db.Decimal(12, 2)
  unbilled        Decimal?  @db.Decimal(12, 2)
  credits         Decimal?  @db.Decimal(12, 2)
  settleDays      Int?
  distratoClauses Json?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  proposal     Proposal?    @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdBy    User         @relation(fields: [createdById], references: [id])

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([clientId])
}

/// Cronômetro em andamento (no máximo um por pessoa).
model RunningTimer {
  id             String   @id @default(cuid())
  organizationId String
  userId         String   @unique
  taskId         String
  startedAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  task         Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

// ---------------------------------------------------------------------------
// Documentos recebidos dos clientes, por competência (mês)
// ---------------------------------------------------------------------------

model DocumentRequirement {
  id             String    @id @default(cuid())
  organizationId String
  clientId       String
  name           String
  required       Boolean   @default(true)
  position       Int       @default(0)
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())

  client   Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  receipts DocumentReceipt[]

  @@index([clientId, archivedAt])
  @@index([organizationId])
}

model DocumentReceipt {
  id            String   @id @default(cuid())
  requirementId String
  /// Competência no formato AAAA-MM.
  competence    String
  receivedAt    DateTime @default(now())
  receivedById  String?
  note          String?

  requirement DocumentRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  receivedBy  User?               @relation("DocumentReceivedBy", fields: [receivedById], references: [id])

  @@unique([requirementId, competence])
  @@index([competence])
}
